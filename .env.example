# Variabili d'Ambiente - Template
# COPIA questo file in .env e sostituisci i valori

# Google Gemini API Key (OBBlIGATORIA)
GEMINI_API_KEY=tuo_codice_api_qui

# Flask Configuration
FLASK_ENV=development    # production in produzione
FLASK_DEBUG=True         # False in produzione
FLASK_PORT=5000

# CORS Configuration
CORS_ORIGINS=http://localhost:5000,http://localhost:8000,https://www.pinizzotto.it

# --- PRODUZIONE (Render / Railway) ---
# 1. Imposta GEMINI_API_KEY, FLASK_ENV=production, CORS_ORIGINS con URL sito
# 2. Start Command: gunicorn app:app
